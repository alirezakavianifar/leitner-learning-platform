# Runtime image configuration using ASP.NET Core 8.0 Alpine
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS final
WORKDIR /app
ENV DOTNET_SYSTEM_NET_DISABLEIPV6=1
EXPOSE 80
EXPOSE 443

# Install SQLCipher dependencies if local client database encryption parsing is handled on the backend
RUN apk add --no-cache icu-libs sqlite-libs

# Copy pre-published application binaries
COPY publish/ .

# Copy database migrations
COPY deployment/db/migrations ./db/migrations

# Ensure the non-privileged app user can write rebuilt course packages
# into wwwroot/courses after admin uploads (directory is otherwise root-owned 755).
RUN mkdir -p /app/wwwroot/courses \
    && chown -R $APP_UID:$APP_UID /app/wwwroot

# Run as non-privileged app user for security hardening
USER $APP_UID

ENTRYPOINT ["dotnet", "LeitnerPlatform.API.dll"]
