# Serve the pre-built React static files using Nginx
# Using public.ecr.aws to prevent Docker Hub 403 Forbidden geo-blocking & rate-limiting
ARG NGINX_IMAGE=public.ecr.aws/nginx/nginx:1.26-alpine
FROM ${NGINX_IMAGE} AS final

COPY admin-panel/dist /usr/share/nginx/html

# Copy custom Nginx configuration to support client-side React Routing redirection
COPY deployment/nginx.admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
