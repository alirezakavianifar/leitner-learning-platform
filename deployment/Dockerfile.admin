# Stage 1: Build the React Application
FROM node:22-alpine AS build
WORKDIR /app

# Copy dependency files to cache npm modules
COPY ["admin-panel/package.json", "admin-panel/package-lock.json*", "./"]
RUN npm ci

# Copy source files and build
COPY admin-panel/ .
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

# Stage 2: Serve the static files using Nginx
FROM nginx:1.26-alpine AS final
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration to support client-side React Routing redirection
COPY deployment/nginx.admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
