<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- In-App Billing permission for Cafe Bazaar -->
    <uses-permission android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR" />

    <!-- Strictly prevent Myket billing permission from appearing in Cafe Bazaar APK -->
    <uses-permission
        android:name="ir.mservices.market.BILLING"
        tools:node="remove" />

    <queries>
        <!-- Package visibility query for Cafe Bazaar In-App Billing service (Android 11+) -->
        <package android:name="com.farsitel.bazaar" />
    </queries>
</manifest>
