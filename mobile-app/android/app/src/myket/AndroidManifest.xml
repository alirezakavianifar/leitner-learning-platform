<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- In-App Billing permission for Myket -->
    <uses-permission android:name="ir.mservices.market.BILLING" />

    <!-- Strictly prevent third-party store billing permissions from appearing in Myket APK -->
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />
    <uses-permission
        android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR"
        tools:node="remove" />

    <queries>
        <!-- Package visibility query for Myket service (Android 11+) -->
        <package android:name="ir.mservices.market" />
    </queries>
</manifest>
