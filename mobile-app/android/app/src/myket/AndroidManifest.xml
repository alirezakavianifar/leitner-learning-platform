<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strictly strip all store billing permissions for Myket review compliance -->
    <uses-permission
        android:name="ir.mservices.market.BILLING"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />
    <uses-permission
        android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR"
        tools:node="remove" />

    <queries>
        <!-- Package visibility query for Myket service (Android 11+) -->
        <package android:name="ir.mservices.market" />
    </queries>
</manifest>
