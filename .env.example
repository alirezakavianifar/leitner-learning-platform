# ==============================================================================
# LEITNER LEARNING PLATFORM - TEMPLATE ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in the values for your deployment.
# WARNING: Do NOT commit the '.env' file containing actual keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_PASSWORD=leitner_secure_pass_2026_change_me
POSTGRES_DB=leitner_db
POSTGRES_USER=leitner_admin
POSTGRES_PORT=5432
POSTGRES_HOST=db

# ------------------------------------------------------------------------------
# 2. CACHE & EVENT BUS CONFIGURATION (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_secure_pass_2026_change_me
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key of at least 256 bits (32 bytes)
JWT_SECRET_KEY=generate_a_very_long_secure_jwt_secret_key_lts_2026
JWT_ISSUER=LeitnerLearningPlatform
JWT_AUDIENCE=LeitnerLearningPlatform
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ------------------------------------------------------------------------------
# 4. DOMESTIC SMS GATEWAY CONFIGURATION (Iran Carriers +98 Support)
# ------------------------------------------------------------------------------
# Select active gateway: kavenegar | farazsms | smsir
SMS_GATEWAY_PROVIDER=kavenegar

# Kavenegar Settings (https://kavenegar.com)
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY_HERE
KAVENEGAR_SENDER_LINE=10008590 # Or your dedicated service line number

# Faraz SMS / IPPanel Settings (https://farazsms.com)
FARAZSMS_USERNAME=your_username
FARAZSMS_PASSWORD=your_password
FARAZSMS_SENDER_LINE=3000505
FARAZSMS_PATTERN_CODE=otp_pattern_code_123

# SMS.ir Settings (https://sms.ir)
SMSIR_API_KEY=YOUR_SMSIR_API_KEY_HERE
SMSIR_SENDER_LINE=3000777

# ------------------------------------------------------------------------------
# 5. DOMESTIC PAYMENT GATEWAY & APP STORE IAP (Shetab Cards Support)
# ------------------------------------------------------------------------------
# ZarinPal IPG Settings (https://next.zarinpal.com)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false # Set to true for developer integration testing

# Cafe Bazaar In-App Purchase (IAP) OAuth Credentials (https://pishkhan.cafebazaar.ir)
CAFE_BAZAAR_CLIENT_ID=your_bazaar_client_id
CAFE_BAZAAR_CLIENT_SECRET=your_bazaar_client_secret
CAFE_BAZAAR_REDIRECT_URI=https://your-api.com/api/v1/purchase/callback/bazaar

# Myket In-App Purchase Credentials (https://developer.myket.ir)
MYKET_DEVELOPER_TOKEN=your_myket_developer_token
MYKET_PACKAGE_NAME=com.alirezakavianifar.leitnerplatform

# ------------------------------------------------------------------------------
# 6. S3-COMPATIBLE DOMESTIC CLOUD BACKUPS & CONTENT STORAGE (ArvanCloud / ParsPack)
# ------------------------------------------------------------------------------
# Endpoint configuration must point to the domestic provider endpoint (no path prefix)
# Examples: 
# ArvanCloud: https://s3.ir-thr-at1.arvanstorage.ir
# ParsPack:   https://s3.parspack.co
BACKUP_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_KEY=YOUR_ARVAN_ACCESS_KEY
BACKUP_S3_SECRET=YOUR_ARVAN_SECRET_KEY
BACKUP_S3_BUCKET=leitner-backups
BACKUP_S3_REGION=ir-thr-at1

# Fallback SFTP Server Backup Configuration (Self-Hosted Domestic Datacenter)
BACKUP_SFTP_HOST=sftp.local-datacenter.ir
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=backup_user
BACKUP_SFTP_PASSWORD=sftp_secure_password
BACKUP_SFTP_PATH=/var/backups/leitner/

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & SECURITY CAPTCHA SETTINGS
# ------------------------------------------------------------------------------
# Redis-based API Rate Limits
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX_REQUESTS=5
RATE_LIMIT_OTP_WINDOW_SECONDS=3600 # 1 hour cooldown for OTP spamming

# CAPTCHA Security Settings
CAPTCHA_SALT=local_captcha_signing_salt_key_2026
CAPTCHA_EXPIRATION_SECONDS=120

# ------------------------------------------------------------------------------
# 8. ADMINISTRATOR SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Comma-separated list of authorized administrator mobile phone numbers (+98912..., 0912...)
ADMIN_ALLOWED_MOBILE_NUMBERS=+989120000000,09120000000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword2026!

