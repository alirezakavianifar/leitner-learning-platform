{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=leitner_db;User Id=leitner_admin;Password=leitner_secure_pass_2026;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=redis_secure_pass_2026"
  },
  "JWT_SECRET_KEY": "jwt_secret_lts_2026_super_secure_key_default",
  "ZarinPal": {
    "MerchantId": "167ccd1b-f5d3-407d-85d1-a73c4f2ba3eb",
    "IsSandbox": false,
    "CallbackUrl": "https://api.rightlearn.ir/api/v1/purchases/zarinpal/callback"
  },
  "AdminSecurity": {
    "AllowedMobileNumbers": "+989120000000,09120000000,09121234567,+989121234567",
    "AdminUsername": "admin",
    "AdminPassword": "AdminSecurePassword2026!"
  }
}


